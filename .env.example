# RefCheck AI environment. Copy to .env and fill in real values (never commit .env).

# --- LLM provider keys -------------------------------------------------------
# Each provider may have a backup key: on a billing/auth error the next key is
# used, and an exhausted key is skipped for REFCHECK_EXHAUSTED_KEY_TTL_HOURS.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_API_KEY_BACKUP=
OPENAI_API_KEY=sk-...
OPENAI_API_KEY_BACKUP=
# Optional providers (registry entries only, never defaults)
GEMINI_API_KEY=
# GOOGLE_API_KEY=            # alternative name for the Gemini key
XAI_API_KEY=
# GROK_API_KEY=              # alternative name for the xAI key
NVIDIA_API_KEY=

# --- Academic APIs -----------------------------------------------------------
NCBI_API_KEY=your-ncbi-api-key
# Used by the stage-4 resolver's Unpaywall lookup; its PDF downloads (PMC / Unpaywall) run
# only with REFCHECK_OA_FETCH=on (below).
UNPAYWALL_EMAIL=your@email.com
SEMANTIC_SCHOLAR_API_KEY=

# Hard per-run LLM budget in USD (stage 5 stops calling models once reached)
# REFCHECK_MAX_COST_USD=50

# When the blind cross-check disagrees with a negative verdict: "soften" (default; show one
# severity step milder, e.g. partially_supported, and flag for review) or "strict" (keep the
# verifier's harsher verdict). See src/refcheck/stages/verify_claims/dispute.py.
# REFCHECK_DISPUTE_POLICY=soften

# Element adjudicator (V5.5): after routing, a partially_supported verdict's listed elements are
# re-checked one by one (stated / co-cited / framing / wording clear them, with a validated quote
# or a note); all cleared -> supported. "off" keeps the cascade's verdict.
# See src/refcheck/stages/verify_claims/adjudicate.py.
# REFCHECK_ADJUDICATE=on

# Co-cited full-text union check (V5.5b, needs the adjudicator): when a partial's surviving
# elements are absent from this reference but the sentence cites others, ONE extra adjudicator
# call searches the co-cited references' full texts (<= 3,000 tokens of targeted passages); an
# element clears only with an exact quote of the named co-cited reference -> fewer elements,
# or supported with guard cocited_share (disputes stay partial). "off" skips it.
# See src/refcheck/stages/verify_claims/cocited_union.py.
# REFCHECK_COCITED_UNION=on

# Strict verifier clearance (V5.6): "on" sends the *_strict.md prompts + schema (each quote's
# "states", a "dismissed" list where every guard needs an exact quote) and audits each clearance
# (dismissals.py). Measured on the 281-pair gold set it was too harsh (over-harsh 66/198 vs 37,
# 3-way 72.2% vs 80.4%), so the default "off" keeps the V5.5 verifier prompts and schema
# byte-identical (cached V5.5 answers are reused). Strict ("on") answers are NOT cached: a strict
# run pays in full. See stages/verify_claims/clearance_mode.py.
# REFCHECK_STRICT_CLEARANCE=off

# V5.7 changes (docs/ARCHITECTURE.md "V5.7"): every proposal is on by default; a comma list of
# proposal numbers turns those off (used by scripts/eval/ablate_v57.py): 1 re-check closure,
# 2 slot audit, 3 diff-based disqualifier, 4 union-hold release, 5 loose about-check,
# 6 credit rubric, 7 fragment spans, 8 cross-check never upgrades a partial, 9 "check first"
# triage, 10 positional cited_for, 11 sub-types (V5.8: + subtype_rules.py), 13 co-cited-only
# -> tangential, 14, 15. V5.8 round-2 fixes (stages/verify_claims/v57.py): 20 screen tie-break
# of a disputed negative, 21 quote edge repair, 22 hedged "stated" kept, 23 author-framing
# scaffolds, 24 near-duplicate survivor, 25 co-cited about-check (or / initialisms), 26 sub-type
# refinements, 27 trigger-free "overstated" -> wording, 28 check-first on a "missing" field,
# 29 overstated / broadened survivors to the union check, 30 deficit terms in the union query,
# 31 polarity trigger of the slot audit (29-31 add adjudicator calls), 32 / 33 the
# contradicted-exclusivity and quantifier parts of 26.
# REFCHECK_V57_DISABLE=
# Experimental V5.8 rules without DEV evidence are OFF by default; list them to turn them on:
# 20, 24, 25, 29, 31, 32, 33 (stages/verify_claims/v57.py OPT_IN).
# REFCHECK_V57_ENABLE=
# Experimental, off by default: #14 prepends the sentence subject to a subjectless cited_for
# (changes the verifier input of those pairs); #15 one blind slot-probe call (role
# adjudicator, prompts/slot_probe.md) for a triaged supported verdict.
# REFCHECK_SUBJECT_PREPEND=off
# REFCHECK_SLOT_PROBE=off

# --- Model roles (V5.1: screen -> verifier -> cross-check, judge for unusual cases) ---
# Defaults (standard profile):
#   screen    = Decisions API gpt-6-luna      (fallback: none -> screen disabled)
#   verifier  = claude-haiku-5-5, effort low  (fallback: gpt-6-luna)
#   judge     = claude-sonnet-5-5, effort low (fallback: gpt-6.1-sol)
#   confirm   = gpt-6-luna, effort low        (fallback: gpt-6.1-sol; must differ in family from the verifier)
#   adjudicator = claude-haiku-5-5, effort low (fallback: gpt-6-luna; element check of partials)
#   utility   = gpt-6-luna, effort none       (fallback: claude-haiku-5-5)
#   embedding = text-embedding-3-small        (fallback: text-embedding-3-large)
# REFCHECK_<ROLE>_MODEL takes a comma list (registry ids or litellm ids) that
# REPLACES the default fallback list; REFCHECK_<ROLE>_EFFORT = none|low|medium|high.
# REFCHECK_SCREEN_MODEL=gpt-6-luna-decisions
# REFCHECK_VERIFIER_MODEL=claude-haiku-5-5,gpt-6-luna
# REFCHECK_JUDGE_MODEL=claude-sonnet-5-5,gpt-6.1-sol
# REFCHECK_CONFIRM_MODEL=gpt-6-luna,gpt-6.1-sol
# REFCHECK_ADJUDICATOR_MODEL=claude-haiku-5-5,gpt-6-luna
# REFCHECK_UTILITY_MODEL=gpt-6-luna,claude-haiku-5-5
# REFCHECK_EMBEDDING_MODEL=text-embedding-3-small,text-embedding-3-large
# REFCHECK_VERIFIER_EFFORT=low
# REFCHECK_JUDGE_EFFORT=low
# REFCHECK_ADJUDICATOR_EFFORT=low
# standard (default) | anthropic_only (screen + embeddings off; haiku verifier, sonnet judge/confirm)
# REFCHECK_PRIVACY_PROFILE=standard

# --- Degraded mode (V5.8) ------------------------------------------------------
# Only the verifier is required. When the normal confirm models are gone (no key, no credits,
# benched by a failed probe) the cross-check runs on claude-sonnet-5-5 (never the verifier's
# model; same family -> every confirmation is queued for review); a dead screen is skipped and
# failed embeddings fall back to BM25-only retrieval. /api/health, the model-status card, the
# stage-5 event and the report say which roles were degraded, why, and what fixes it.
# "off" disables the confirm fallback (the cross-check then fails -> review).
# REFCHECK_DEGRADED_FALLBACKS=on
# USD cap per degraded role per run (default: the smaller of $2 and 25% of REFCHECK_MAX_COST_USD)
# REFCHECK_DEGRADED_MAX_USD=2

# --- Fast screen (Decisions API) ---------------------------------------------
# REFCHECK_SCREEN_ENABLED=true
# REFCHECK_SCREEN_T_ACCEPT=0.97          # auto-clear threshold (overrides the calibration file)
# REFCHECK_SCREEN_CALIBRATION=~/.refcheck/calibration/screen.json  # written by scripts/eval/calibrate_screen.py;
#                                        # "auto_clear": false keeps the screen on but never auto-clears
# REFCHECK_SCREEN_CONCURRENCY=64

# --- Verification budget / concurrency ---------------------------------------
# REFCHECK_MAX_CONCURRENT_CLAIMS=12
# REFCHECK_CLAIM_TIMEOUT_SECONDS=180     # per claim-reference pair
# REFCHECK_EMBED_TIMEOUT_SECONDS=60
# REFCHECK_OPENAI_CONCURRENCY=32         # REFCHECK_<PROVIDER>_CONCURRENCY
# REFCHECK_ANTHROPIC_CONCURRENCY=16      # other providers default to 8
# REFCHECK_LLM_THREADS=64
# REFCHECK_LLM_MAX_ATTEMPTS=4
# REFCHECK_API_CONCURRENCY=              # academic API lookups

# --- Keys, preflight, caches, storage ----------------------------------------
# REFCHECK_KEY_STATE_FILE=~/.refcheck/state/key_state.json
# REFCHECK_EXHAUSTED_KEY_TTL_HOURS=6
# REFCHECK_PREFLIGHT_TTL_SECONDS=600
# REFCHECK_CACHE_DIR=~/.refcheck/cache
# REFCHECK_LLM_CACHE_TTL=604800          # 7 days
# REFCHECK_API_CACHE_TTL=86400           # 24 h
# REFCHECK_PDF_CACHE_TTL=2592000         # 30 days
# REFCHECK_DB_PATH=~/.refcheck/refcheck.db
# REFCHECK_LIBRARY_DB=~/.refcheck/library.db
# REFCHECK_LIBRARY_DIR=~/.refcheck/library/pdfs
# Shared PDF library of earlier runs (V3; V5.8: stage 4 re-matches references without a usable
# PDF against it with the identity / supplement / scan checks, never linking a wrong paper)
# REFCHECK_SHARED_LIBRARY_DIR=~/.refcheck/library

# --- Open-access fetch (V5.8, OFF by default: downloads need your consent) ----
# "on": a reference still without a usable PDF after the library re-match gets a legal
# open-access copy (Unpaywall by DOI, Europe PMC, PMC), kept only when it passes the same
# identity checks, then stored in the library. Also gates the stage-4 resolver's PMC /
# Unpaywall downloads (off: a found reference keeps its journal link). Never enabled in tests.
# REFCHECK_OA_FETCH=off
# Contact e-mail sent ONLY to Unpaywall (required by its terms; Unpaywall is skipped without it)
# REFCHECK_CONTACT_EMAIL=
# REFCHECK_OA_MAX_MB=50                  # largest download accepted
# REFCHECK_OA_MAX_FETCHES=25             # references fetched per run (<= 3 candidates each)
# REFCHECK_LOG_LEVEL=INFO
